{
  "name": "@local/dotnet-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosts .NET plugins in one long-lived worker and exposes their [DshTool] methods as Harness tools.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "bin",
    "bench",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
