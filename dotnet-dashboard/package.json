{
  "name": "@local/dotnet-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shows the local .NET SDK and NuGet state, and gives .NET projects a guidance sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lorangeve/dsh-plugins.git",
    "directory": "dotnet-dashboard"
  }
}
