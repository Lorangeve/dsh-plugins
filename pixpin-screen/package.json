{
  "name": "@local/pixpin-screen",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Captures the screen through PixPin, annotates and pins it, and runs orchestrated mouse/keyboard actions with AutoHotkey. Either tool can be switched off in the plugin config.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lorangeve/dsh-plugins.git",
    "directory": "pixpin-screen"
  }
}
